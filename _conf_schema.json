{
  "providers": {
    "description": "搜索服务",
    "type": "object",
    "items": {
      "saucenao": {
        "description": "SauceNAO",
        "type": "object",
        "items": {
          "enabled": {
            "type": "bool",
            "description": "启用 SauceNAO",
            "default": true
          },
          "api_key": {
            "type": "string",
            "description": "API Key",
            "default": "",
            "secret": true
          },
          "aliases": {
            "type": "list",
            "description": "渠道别名",
            "hint": "每项一个别名，直接填写名称，无需等号。不可覆盖内置名称，别名不会启用渠道。",
            "default": [
              "s"
            ]
          },
          "min_similarity": {
            "type": "int",
            "description": "最低相似度百分比",
            "default": 60,
            "slider": {
              "min": 0,
              "max": 100,
              "step": 1
            },
            "hint": "低于此值的候选不展示；默认搜图可按补搜设置尝试其他渠道。"
          },
          "low_similarity_provider": {
            "type": "string",
            "description": "SauceNAO 相似度过低时自动使用",
            "hint": "相似度不足时使用所选已启用渠道补搜；不补搜则结束。指定渠道搜索时不追加渠道。",
            "options": [
              "off",
              "Ascii2d",
              "google"
            ],
            "default": "off",
            "labels": [
              "不补搜",
              "Ascii2d",
              "Google Lens"
            ]
          },
          "max_results": {
            "type": "int",
            "description": "请求候选数量",
            "default": 5,
            "hint": "控制上游返回的候选数量，最终选择一条可靠结果展示。"
          }
        }
      },
      "google_lens": {
        "description": "Google Lens",
        "type": "object",
        "items": {
          "enabled": {
            "type": "bool",
            "description": "启用 Google Lens",
            "default": true
          },
          "serpapi_keys": {
            "type": "list",
            "description": "SerpAPI Keys",
            "hint": "支持多个 Key 轮换；认证或额度被拒绝时尝试下一个。",
            "default": [],
            "secret": true
          },
          "aliases": {
            "type": "list",
            "description": "渠道别名",
            "hint": "每项一个别名，直接填写名称，无需等号。不可覆盖内置名称，别名不会启用渠道。",
            "default": [
              "g",
              "谷歌"
            ]
          },
          "max_results": {
            "type": "int",
            "description": "最大结果数",
            "default": 3
          },
          "search_type": {
            "type": "string",
            "description": "搜索类型",
            "options": [
              "all",
              "visual_matches",
              "exact_matches"
            ],
            "default": "all",
            "labels": [
              "默认搜索",
              "相似图片",
              "完全匹配"
            ]
          },
          "safe_search": {
            "type": "string",
            "description": "安全搜索",
            "hint": "服务默认：使用上游设置；关闭或开启：明确指定是否过滤。",
            "options": [
              "default",
              "off",
              "active"
            ],
            "default": "off",
            "labels": [
              "服务默认",
              "关闭",
              "开启"
            ]
          },
          "language": {
            "type": "string",
            "description": "结果语言",
            "default": "zh-cn"
          },
          "country": {
            "type": "string",
            "description": "国家或地区代码",
            "default": "",
            "hint": "留空使用服务默认地区；可填写两位国家代码，如 jp、us。"
          },
          "auto_crop": {
            "type": "bool",
            "description": "自动裁剪识别区域",
            "default": false,
            "hint": "自动识别并裁剪重点区域，可能影响整图匹配。"
          },
          "no_cache": {
            "type": "bool",
            "description": "跳过 SerpAPI 缓存",
            "default": false,
            "hint": "跳过 SerpAPI 缓存，不影响插件本地缓存；需要同时刷新两层缓存时使用 -purge。"
          }
        }
      },
      "ascii2d": {
        "description": "Ascii2d",
        "type": "object",
        "items": {
          "enabled": {
            "type": "bool",
            "description": "启用 Ascii2d",
            "default": true
          },
          "aliases": {
            "type": "list",
            "description": "渠道别名",
            "hint": "每项一个别名，直接填写名称，无需等号。不可覆盖内置名称，别名不会启用渠道。",
            "default": [
              "a"
            ]
          },
          "session_id": {
            "type": "string",
            "description": "_session_id Cookie",
            "hint": "网站要求会话时填写对应 Cookie。",
            "default": "",
            "secret": true
          },
          "cf_clearance": {
            "type": "string",
            "description": "cf_clearance Cookie",
            "hint": "遇到 Cloudflare 验证时填写对应 Cookie。",
            "default": "",
            "secret": true
          }
        }
      },
      "trace_moe": {
        "description": "trace.moe",
        "type": "object",
        "items": {
          "enabled": {
            "type": "bool",
            "description": "启用 trace.moe 搜番",
            "default": true
          },
          "token": {
            "type": "string",
            "description": "Token",
            "hint": "可选，留空使用匿名额度。",
            "default": "",
            "secret": true
          },
          "min_similarity": {
            "type": "int",
            "description": "最低相似度百分比",
            "default": 50,
            "slider": {
              "min": 0,
              "max": 100,
              "step": 1
            }
          },
          "max_results": {
            "type": "int",
            "description": "最大结果数",
            "default": 3
          },
          "cut_borders": {
            "type": "bool",
            "description": "自动裁剪黑边",
            "default": true
          }
        }
      },
      "soutubot": {
        "description": "Soutubot",
        "type": "object",
        "items": {
          "enabled": {
            "type": "bool",
            "description": "启用 Soutubot搜本",
            "default": false,
            "hint": "仅用于搜本或明确指定 soutubot 渠道"
          },
          "max_results": {
            "type": "int",
            "description": "最大结果数",
            "default": 3,
            "slider": {
              "min": 1,
              "max": 10,
              "step": 1
            }
          }
        }
      }
    }
  },
  "command": {
    "description": "命令交互",
    "type": "object",
    "items": {
      "simple_natural_language": {
        "type": "bool",
        "description": "自然语言直接搜图",
        "hint": "明确搜图请求和使用方法问句直接处理，不调用 LLM；“搜一下”需附图，遵守会话唤醒条件。",
        "default": true
      },
      "max_batch_images": {
        "type": "int",
        "description": "每次最多搜索图片数",
        "hint": "超出上限只处理前面的图片，并提示未处理数量。",
        "default": 5
      },
      "daily_search_limit": {
        "type": "int",
        "description": "每名用户每日搜索次数",
        "hint": "0 不限制，管理员免限。每图一次，低相似度计次；缓存命中、全部失败或无候选不计。按 Bot 时区每日重置。",
        "default": 30
      },
      "image_wait_timeout_seconds": {
        "type": "int",
        "description": "无图命令等待秒数",
        "hint": "发送不带图片的搜图命令后，等待图片的最长时间。",
        "default": 60,
        "slider": {
          "min": 10,
          "max": 120,
          "step": 5
        }
      }
    }
  },
  "search_mode": {
    "description": "搜图模式",
    "type": "object",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用搜图模式",
        "hint": "允许用户开启连续搜图；关闭后普通搜图命令仍可使用。",
        "default": true
      },
      "timeout_seconds": {
        "type": "int",
        "description": "空闲退出秒数",
        "hint": "范围 10–3600 秒；发图或重新开启、切换模式时续期，群聊和私聊均生效。",
        "default": 60
      }
    }
  },
  "llm": {
    "description": "LLM 工具",
    "type": "object",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用 LLM 搜图工具",
        "hint": "允许模型在明确搜图请求中调用搜索工具；不影响命令和自然语言直达。",
        "default": true
      }
    }
  },
  "output": {
    "description": "结果展示",
    "type": "object",
    "items": {
      "merged_forward_threshold": {
        "type": "int",
        "description": "合并推送触发条数",
        "hint": "按普通消息数：0 不合并，1 始终合并，2–10 达到即合并。同图两条及以上结果始终合并转发（含设为 0 时）；仅支持的平台生效。",
        "default": 2,
        "slider": {
          "min": 0,
          "max": 10,
          "step": 1
        }
      },
      "show_thumbnails": {
        "type": "bool",
        "description": "显示结果缩略图",
        "hint": "仅使用搜索服务提供的缩略图，不下载原图；加载失败保留文字。",
        "default": true
      },
      "max_preview_images": {
        "type": "int",
        "description": "每张输入图片最多展示缩略图数",
        "hint": "每张输入图片独立计算上限；多余结果保留文字和链接。",
        "default": 6,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        }
      },
      "resolve_original_source": {
        "type": "bool",
        "description": "补全转载页的原始出处",
        "hint": "从支持的图站作品页提取原始出处；额外等待最多 6 秒，失败保留现有链接。",
        "default": true
      }
    }
  },
  "cache": {
    "description": "搜索结果缓存",
    "type": "object",
    "items": {
      "enabled": {
        "type": "bool",
        "description": "启用搜索结果缓存",
        "default": true
      },
      "expire_seconds": {
        "type": "int",
        "description": "缓存有效秒数",
        "hint": "默认 172800 秒（48 小时）；-purge 跳过本地缓存重新搜索，并跳过 Google 的 SerpAPI 缓存。",
        "default": 172800
      }
    }
  },
  "network": {
    "description": "网络",
    "type": "object",
    "items": {
      "proxy_url": {
        "type": "string",
        "description": "HTTP 代理",
        "hint": "留空直连；Docker 中 127.0.0.1 指容器自身，不是宿主机。",
        "default": ""
      },
      "timeout_seconds": {
        "type": "int",
        "description": "请求超时秒数",
        "default": 30
      },
      "user_agent": {
        "type": "string",
        "description": "User-Agent",
        "default": "AstrBot Image Search/0.1"
      }
    },
    "debug_logging": {
      "type": "bool",
      "description": "调试日志",
      "default": false,
      "hint": "开启详细流程日志，便于排查问题。"
    }
  }
}
